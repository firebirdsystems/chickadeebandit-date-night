{
  "scenarios": [
    {
      "name": "a one-sided pairing does not open the shared idea list",
      "members": {
        "a": "adult",
        "b": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_date_night_planner__partner_config (member_id, partner_id, session_id) VALUES (?, ?, ?)",
          "params": [
            "{{a}}",
            "{{b}}",
            "sess-ab"
          ]
        },
        {
          "action": "open",
          "as": "a"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"view-setup\"]",
          "as": "a"
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_date_night_planner__partner_config (member_id, partner_id, session_id) VALUES (?, ?, ?)",
          "params": [
            "{{b}}",
            "{{a}}",
            "sess-ab"
          ]
        },
        {
          "action": "reload",
          "as": "a"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"view-main\"]",
          "as": "a"
        }
      ]
    },
    {
      "name": "a completed date leaves the ideas tab for history, carrying its rating",
      "members": {
        "a": "adult",
        "b": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_date_night_planner__partner_config (member_id, partner_id, session_id) VALUES (?, ?, ?)",
          "params": [
            "{{a}}",
            "{{b}}",
            "sess-ab"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_date_night_planner__partner_config (member_id, partner_id, session_id) VALUES (?, ?, ?)",
          "params": [
            "{{b}}",
            "{{a}}",
            "sess-ab"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_date_night_planner__date_ideas (id, created_by, title, done_at, rating, created_at, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)",
          "params": [
            "i1",
            "{{a}}",
            "Rooftop dinner",
            null,
            null,
            "2026-01-01T00:00:00Z",
            "sess-ab"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_date_night_planner__date_ideas (id, created_by, title, done_at, rating, created_at, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)",
          "params": [
            "i2",
            "{{b}}",
            "Drive-in movie",
            null,
            null,
            "2026-01-02T00:00:00Z",
            "sess-ab"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_date_night_planner__date_ideas (id, created_by, title, done_at, rating, created_at, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)",
          "params": [
            "i3",
            "{{a}}",
            "Pottery class",
            "2026-01-03T00:00:00Z",
            4,
            "2026-01-01T00:00:00Z",
            "sess-ab"
          ]
        },
        {
          "action": "open",
          "as": "b"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"view-main\"]",
          "as": "b"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"tab-ideas\"] [data-testid=\"idea-card\"][data-idea-id=\"i1\"]",
          "count": 1,
          "as": "b"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"tab-ideas\"] [data-testid=\"idea-card\"][data-idea-id=\"i3\"]",
          "count": 0,
          "as": "b"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"tab-history\"] [data-testid=\"idea-card\"][data-idea-id=\"i3\"][data-done=\"yes\"]",
          "count": 1,
          "as": "b"
        },
        {
          "action": "expectText",
          "selector": "[data-testid=\"idea-card\"][data-idea-id=\"i3\"]",
          "text": "★★★★☆",
          "as": "b"
        },
        {
          "action": "expectText",
          "selector": "[data-testid=\"idea-card\"][data-idea-id=\"i3\"]",
          "text": "Pottery class",
          "as": "b"
        }
      ]
    }
  ]
}
